0;" edge="1" parent="1" source="g-prod" target="x-ls"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#616161;strokeWidth=1.2;dashed=1;endArrow=block;endFill=0;fontColor=#616161;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="g-test" target="g-cop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e31" value="tools.charge_item, get_*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#616161;strokeWidth=1.2;dashed=1;endArrow=block;endFill=0;fontColor=#616161;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0;exitY=0.14;exitDx=0;exitDy=0;" edge="1" parent="1" source="g-test" target="g-mcp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1530" y="815"/><mxPoint x="965" y="815"/></Array></mxGeometry></mxCell><mxCell id="p1-e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=1.5;endArrow=open;fontColor=#1565C0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="t-dc" target="x-cij"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1896" y="957"/><mxPoint x="1896" y="245"/><mxPoint x="1778" y="245"/></Array></mxGeometry></mxCell><mxCell id="p1-e33" value="informed the state design" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=1;dashPattern=1 3;endArrow=block;endFill=0;fontColor=#6A1B9A;entryX=0.4;entryY=1;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="o-fr" target="g-prod"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="1167"/></Array></mxGeometry></mxCell><mxCell id="p1-e34" value="explains" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=1;dashPattern=1 3;endArrow=block;endFill=0;fontColor=#6A1B9A;entryX=0.57;entryY=1;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="o-run" target="g-mcp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="1237"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2 · Graph ↔ files ↔ LangChain / LangGraph"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1470" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2-title" value="&lt;b&gt;RM Copilot graph — which file implements each node, and which LangChain / LangGraph piece it uses&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px;color:#546E7A&#x27;&gt;Graph wired in production/04_supervisor_brief.ipynb → build(tools). Nodes live in copilot/ (research, signal, policy) or in notebook 04 (supervisor, brief).&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="60" as="geometry"/></mxCell><mxCell id="p2-state" value="&lt;b&gt;State — CopilotState (TypedDict, total=False) · notebook 04 §2&lt;/b&gt; &amp;nbsp; &lt;i&gt;one dict passed along every edge; each node returns only the slots it fills and LangGraph merges them&lt;/i&gt;&lt;br&gt;&lt;b&gt;input&lt;/b&gt;: company_number, as_of &amp;nbsp;│&amp;nbsp; &lt;b&gt;evidence&lt;/b&gt; (overwritten each pass — a retry re-fetches the whole record): profile, filings, charges, officers, research_errors, signals, applicable, outcome, qualifies, evidence_gap, policy_trace&lt;br&gt;&lt;b&gt;control&lt;/b&gt;: research_attempts, route, &lt;b&gt;supervisor_log: Annotated[list, operator.add]&lt;/b&gt; ← the only appending reducer &amp;nbsp;│&amp;nbsp; &lt;b&gt;output&lt;/b&gt;: brief, citations, brief_dropped" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=#FFFDE7;strokeColor=#FBC02D;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="80" width="1080" height="96" as="geometry"/></mxCell><mxCell id="g-start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#FFFFFF;strokeColor=#263238;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="200" width="80" height="36" as="geometry"/></mxCell><mxCell id="g-research" value="research" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#1E88E5;fontColor=#FFFFFF;strokeColor=#0D47A1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="830" y="270" width="200" height="64" as="geometry"/></mxCell><mxCell id="g-signal" value="signal" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#1E88E5;fontColor=#FFFFFF;strokeColor=#0D47A1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="830" y="450" width="200" height="64" as="geometry"/></mxCell><mxCell id="g-policy" value="policy" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#1E88E5;fontColor=#FFFFFF;strokeColor=#0D47A1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="830" y="630" width="200" height="64" as="geometry"/></mxCell><mxCell id="g-sup" value="supervisor" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFB300;fontColor=#000000;strokeColor=#E65100;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="830" y="800" width="200" height="96" as="geometry"/></mxCell><mxCell id="g-brief" value="brief" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#1E88E5;fontColor=#FFFFFF;strokeColor=#0D47A1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="830" y="990" width="200" height="64" as="geometry"/></mxCell><mxCell id="g-end" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#FFFFFF;strokeColor=#263238;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="1110" width="80" height="36" as="geometry"/></mxCell><mxCell id="p2-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="g-start" target="g-research"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e2" value="add_edge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="g-research" target="g-signal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="g-signal" target="g-policy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="g-policy" target="g-sup"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e5" value="route = brief" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="g-sup" target="g-brief"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="g-brief" target="g-end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e7" value="route = research (fetch failed, ≤ 2 retries · EVD-05)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#C62828;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="g-sup" target="g-research"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="848"/><mxPoint x="1060" y="302"/></Array></mxGeometry></mxCell><mxCell id="i-research" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;copilot/research.py · make_research(tools)&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;built in production/01 · reads company_number · writes profile, filings, charges, officers, research_errors · 4 MCP calls via asyncio.gather; a failed call is recorded, not raised&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#3949AB;" vertex="1" parent="1"><mxGeometry x="400" y="250" width="400" height="104" as="geometry"/></mxCell><mxCell id="p2-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1" source="i-research" target="g-research"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-research" value="&lt;div style=&quot;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;LangChain: MultiServerMCPClient + StructuredTool&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;no model · tool calls are LangChain tools, so LangSmith traces them&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#EF6C00;" vertex="1" parent="1"><mxGeometry x="1100" y="250" width="360" height="104" as="geometry"/></mxCell><mxCell id="p2-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1" source="g-research" target="m-research"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i-signal" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;copilot/signals.py · signal&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;built in production/02 · reads the 4 records + as_of · writes signals (a fact per clause, each with record refs) · uses refs.charge_refs&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#3949AB;" vertex="1" parent="1"><mxGeometry x="400" y="430" width="400" height="104" as="geometry"/></mxCell><mxCell id="p2-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1" source="i-signal" target="g-signal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-signal" value="&lt;div style=&quot;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;1 Claude call — collateral&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;llm.client().beta.messages.parse(output_format=Labels) · effort low · quote checked in code · skipped if no particulars&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#8E24AA;" vertex="1" parent="1"><mxGeometry x="1100" y="430" width="360" height="104" as="geometry"/></mxCell><mxCell id="p2-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1" source="g-signal" target="m-signal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i-policy" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;copilot/policy.py · policy → evaluate&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;built in production/03 · reads signals + charges · writes applicable, outcome, qualifies, evidence_gap, policy_trace · clauses from policy_store.load_clauses&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#3949AB;" vertex="1" parent="1"><mxGeometry x="400" y="610" width="400" height="104" as="geometry"/></mxCell><mxCell id="p2-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1" source="i-policy" target="g-policy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-policy" value="&lt;div style=&quot;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;0–1 Claude call — reading&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;only for unrecorded flags (pre-2013) or a clause with no rule · parse(Judgements) · quotes checked; unverifiable → gap&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#8E24AA;" vertex="1" parent="1"><mxGeometry x="1100" y="610" width="360" height="104" as="geometry"/></mxCell><mxCell id="p2-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1" source="g-policy" target="m-policy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i-supervisor" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;notebook 04 §3 · supervisor (not in copilot/ yet)&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;reads evidence_gap, qualifies, research_errors, research_attempts · writes route, research_attempts, supervisor_log · plain code&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#3949AB;" vertex="1" parent="1"><mxGeometry x="400" y="780" width="400" height="104" as="geometry"/></mxCell><mxCell id="p2-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1" source="i-supervisor" target="g-sup"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-supervisor" value="&lt;div style=&quot;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;LangGraph: add_conditional_edges&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;no model · lambda s: s[&amp;#x27;route&amp;#x27;] → {research, brief} · shows in LangSmith as an unnamed run&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="1100" y="780" width="360" height="104" as="geometry"/></mxCell><mxCell id="p2-e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1" source="g-sup" target="m-supervisor"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i-brief" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;notebook 04 §5–7 · brief (not in copilot/ yet)&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;reads profile, signals, applicable, outcome, evidence_gap · writes brief, citations, brief_dropped · fact_sheet → model → validate → render&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#3949AB;" vertex="1" parent="1"><mxGeometry x="400" y="970" width="400" height="104" as="geometry"/></mxCell><mxCell id="p2-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1" source="i-brief" target="g-brief"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-brief" value="&lt;div style=&quot;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;1 Claude call — summary&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;parse(Draft) · every statement must cite fact-sheet keys (EVD-02); code writes decision + clause table (EVD-06/07)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#8E24AA;" vertex="1" parent="1"><mxGeometry x="1100" y="970" width="360" height="104" as="geometry"/></mxCell><mxCell id="p2-e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1" source="g-brief" target="m-brief"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tl" value="Tool layer — LangChain ↔ MCP" style="swimlane;startSize=28;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#EF6C00;fontColor=#FFFFFF;strokeColor=#EF6C00;swimlaneFillColor=#FFF3E0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="350" height="620" as="geometry"/></mxCell><mxCell id="tl1" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;MultiServerMCPClient&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;langchain-mcp-adapters · research.load_tools() → get_tools()&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#EF6C00;" vertex="1" parent="tl"><mxGeometry x="10" y="36" width="330" height="66" as="geometry"/></mxCell><mxCell id="tl2" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;StructuredTool × 4 · .ainvoke()&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;get_company_profile · get_filing_history · get_charges · get_officers&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#EF6C00;" vertex="1" parent="tl"><mxGeometry x="10" y="118" width="330" height="66" as="geometry"/></mxCell><mxCell id="tl3" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;stdio subprocess (per call)&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;python -m mcp_ch.server — no port, no network listener&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#EF6C00;" vertex="1" parent="tl"><mxGeometry x="10" y="200" width="330" height="66" as="geometry"/></mxCell><mxCell id="tl4" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;mcp_ch/server.py&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;FastMCP · @server.tool() → name, docstring, schema&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#EF6C00;" vertex="1" parent="tl"><mxGeometry x="10" y="282" width="330" height="66" as="geometry"/></mxCell><mxCell id="tl5" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;mcp_ch/tools.py&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;trims + resolves facts in code (days_late, lender_group, flags)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#EF6C00;" vertex="1" parent="tl"><mxGeometry x="10" y="364" width="330" height="66" a