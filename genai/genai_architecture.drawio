F;strokeColor=#616161;strokeWidth=1.2;dashed=1;endArrow=block;endFill=0;fontColor=#616161;" edge="1" parent="1" source="tl3" target="tl4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#616161;strokeWidth=1.2;dashed=1;endArrow=block;endFill=0;fontColor=#616161;" edge="1" parent="1" source="tl4" target="tl5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#616161;strokeWidth=1.2;dashed=1;endArrow=block;endFill=0;fontColor=#616161;" edge="1" parent="1" source="tl5" target="tl6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#616161;strokeWidth=1.2;dashed=1;endArrow=block;endFill=0;fontColor=#616161;" edge="1" parent="1" source="tl6" target="tl7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.2;endArrow=none;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="i-research" target="tl1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pc" value="Policy corpus" style="swimlane;startSize=28;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#8E24AA;fontColor=#FFFFFF;strokeColor=#8E24AA;swimlaneFillColor=#F3E5F5;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="350" height="250" as="geometry"/></mxCell><mxCell id="pc1" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;policies/*.md&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;23 clauses · &amp;#x27;### &amp;#x27; heading = one clause · Outcome: line&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#8E24AA;" vertex="1" parent="pc"><mxGeometry x="10" y="36" width="330" height="60" as="geometry"/></mxCell><mxCell id="pc2" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;policy_store.load_clauses()&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;parse only — no embeddings. Chroma retrieval not used by the graph (k=3 missed CON-02)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#8E24AA;" vertex="1" parent="pc"><mxGeometry x="10" y="106" width="330" height="66" as="geometry"/></mxCell><mxCell id="pc3" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;copilot/policy.CLAUSES&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;RULES (16) · ROUTED (7) · clause text → model + brief&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#8E24AA;" vertex="1" parent="pc"><mxGeometry x="10" y="182" width="330" height="58" as="geometry"/></mxCell><mxCell id="p2-e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=1.5;endArrow=open;fontColor=#1565C0;" edge="1" parent="1" source="pc1" target="pc2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#616161;strokeWidth=1.2;dashed=1;endArrow=block;endFill=0;fontColor=#616161;" edge="1" parent="1" source="pc2" target="pc3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1" source="pc3" target="i-policy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ml" value="Model layer — Anthropic SDK, not a LangChain chat model" style="swimlane;startSize=28;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontStyle=1;fontSize=12;fillColor=#8E24AA;fontColor=#FFFFFF;strokeColor=#8E24AA;swimlaneFillColor=#F3E5F5;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1500" y="440" width="380" height="400" as="geometry"/></mxCell><mxCell id="ml1" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;copilot/llm.py&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;client() → AsyncAnthropic (lazy) · MODEL = claude-opus-5 · FALLBACK = server-side fallbacks &amp;#x27;default&amp;#x27;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#8E24AA;" vertex="1" parent="ml"><mxGeometry x="10" y="40" width="360" height="80" as="geometry"/></mxCell><mxCell id="ml2" value="&lt;div style=&quot;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;messages.parse(output_format=Pydantic)&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;Labels (signal) · Judgements (policy) · Draft (brief) — answer shape fixed, code checks quotes / sources&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#8E24AA;" vertex="1" parent="ml"><mxGeometry x="10" y="134" width="360" height="80" as="geometry"/></mxCell><mxCell id="ml3" value="&lt;div style=&quot;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;Anthropic API&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;3 kinds of call per company at most: collateral, policy reading, brief&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#546E7A;" vertex="1" parent="ml"><mxGeometry x="10" y="228" width="360" height="66" as="geometry"/></mxCell><mxCell id="ml4" value="&lt;b&gt;Consequence:&lt;/b&gt; these calls bypass LangChain callbacks, so LangSmith does &lt;b&gt;not&lt;/b&gt; record them (no llm runs, 0 tokens). See page 3." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=11;" vertex="1" parent="ml"><mxGeometry x="10" y="306" width="360" height="80" as="geometry"/></mxCell><mxCell id="p2-e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#616161;strokeWidth=1.2;dashed=1;endArrow=block;endFill=0;fontColor=#616161;" edge="1" parent="1" source="ml1" target="ml2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;endArrow=block;endFill=1;fontColor=#C62828;" edge="1" parent="1" source="ml2" target="ml3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#616161;strokeWidth=1.2;dashed=1;endArrow=block;endFill=0;fontColor=#616161;" edge="1" parent="1" source="m-signal" target="ml1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#616161;strokeWidth=1.2;dashed=1;endArrow=block;endFill=0;fontColor=#616161;" edge="1" parent="1" source="m-policy" target="ml1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#616161;strokeWidth=1.2;dashed=1;endArrow=block;endFill=0;fontColor=#616161;" edge="1" parent="1" source="m-brief" target="ml1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-concepts" value="&lt;b&gt;LangGraph / LangChain concept → where it is in the code → where it was learned&lt;/b&gt;&lt;table style=&#x27;font-size:11px;border-collapse:collapse;margin-top:6px&#x27; border=&#x27;1&#x27; cellpadding=&#x27;4&#x27;&gt;&lt;tr style=&#x27;background:#CFD8DC&#x27;&gt;&lt;th&gt;concept&lt;/th&gt;&lt;th&gt;RM Copilot (production)&lt;/th&gt;&lt;th&gt;learned in&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;StateGraph(CopilotState) · add_node · add_edge · compile()&lt;/td&gt;&lt;td&gt;notebook 04 build(tools)&lt;/td&gt;&lt;td&gt;04_langgraph, 05_primitive_langgraph&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;add_conditional_edges(node, fn, mapping)&lt;/td&gt;&lt;td&gt;supervisor → route → {research, brief}; the retry loop&lt;/td&gt;&lt;td&gt;04_langgraph should_continue&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Annotated[list, operator.add] reducer&lt;/td&gt;&lt;td&gt;supervisor_log only (evidence slots overwrite on purpose)&lt;/td&gt;&lt;td&gt;04_langgraph MessagesState&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;graph.ainvoke(state) · async nodes&lt;/td&gt;&lt;td&gt;every production run&lt;/td&gt;&lt;td&gt;production/01 (first async node)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MultiServerMCPClient · get_tools() · StructuredTool.ainvoke&lt;/td&gt;&lt;td&gt;copilot/research.py&lt;/td&gt;&lt;td&gt;mcp_ch/agent_check.py, production/01&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;@tool / create_agent / deep agent / InMemorySaver&lt;/td&gt;&lt;td&gt;&lt;i&gt;not used&lt;/i&gt; — the graph is fixed, not a free agent loop&lt;/td&gt;&lt;td&gt;02_langchain, agent_check&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;structured output&lt;/td&gt;&lt;td&gt;anthropic messages.parse(Pydantic) in signal, policy, brief&lt;/td&gt;&lt;td&gt;03 / 05 with_structured_output(FilingSummary)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;retrieval (Chroma, retrieve_facets)&lt;/td&gt;&lt;td&gt;&lt;i&gt;not used&lt;/i&gt; — selection by clause ID over all 23 clauses&lt;/td&gt;&lt;td&gt;06_rag, policy_store.py&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;fetch → summarise (one model node)&lt;/td&gt;&lt;td&gt;split into research → signal: facts in code, one small model call&lt;/td&gt;&lt;td&gt;05_primitive_langgraph, rm_copilot_graph.drawio&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=#FAFAFA;strokeColor=#9E9E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1170" width="1860" height="280" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3 · Observability"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3-title" value="&lt;b&gt;Observability — what you can see about a run today, and what you can&#x27;t&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px;color:#546E7A&#x27;&gt;LangSmith facts below come from the project&#x27;s own traces (read-only query, 2026-09-25): latest full-graph trace 2026-09-24 08:30.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="60" as="geometry"/></mxCell><mxCell id="o-start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#FFFFFF;strokeColor=#263238;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="100" width="80" height="34" as="geometry"/></mxCell><mxCell id="o-research" value="research" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#1E88E5;fontColor=#FFFFFF;strokeColor=#0D47A1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="180" height="56" as="geometry"/></mxCell><mxCell id="o-signal" value="signal" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#1E88E5;fontColor=#FFFFFF;strokeColor=#0D47A1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="180" height="56" as="geometry"/></mxCell><mxCell id="o-policy" value="policy" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#1E88E5;fontColor=#FFFFFF;strokeColor=#0D47A1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="180" height="56" as="geometry"/></mxCell><mxCell id="o-brief" value="brief" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#1E88E5;fontColor=#FFFFFF;strokeColor=#0D47A1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="180" height="56" as="geometry"/></mxCell><mxCell id="o-supervisor" value="supervisor" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFB300;fontColor=#000000;strokeColor=#E65100;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="180" height="84" as="geometry"/></mxCell><mxCell id="o-end" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#FFFFFF;strokeColor=#263238;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="950" width="80" height="34" as="geometry"/></mxCell><mxCell id="p3-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="o-start" target="o-research"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="o-research" target="o-signal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="o-signal" target="o-policy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="o-policy" target="o-supervisor"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="o-supervisor" target="o-brief"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="o-brief" target="o-end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-e7" value="retry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#C62828;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o-supervisor" target="o-research"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="692"/><mxPoint x="20" y="198"/></Array></mxGeometry></mxCell><mxCell id="aud" value="① In the state — every run returns its own audit trail" style="swimlane;startSize=28;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#FBC02D;fontColor=#FFFFFF;strokeColor=#FBC02D;swimlaneFillColor=#FFFDE7;collapsible=0;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="470" height="900" as="geometry"/></mxCell><mxCell id="a-research" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;research_errors&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;which tool call failed and why — the supervisor&amp;#x27;s retry signal&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#FBC02D;" vertex="1" parent="aud"><mxGeometry x="10" y="84" width="450" height="96" as="geometry"/></mxCell><mxCell id="p3-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1" source="o-research" target="a-research"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a-signal" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;signals.missing · collateral[ref].verified + quote&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;what EVD-01 lacks; whether the model&amp;#x27;s collateral label was found in the text&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#FBC02D;" vertex="1" parent="aud"><mxGeometry x="10" y="244" width="450" height="96" as="geometry"/></mxCell><mxCell id="p3-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1" source="o-signal" target="a-signal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a-policy" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;policy_trace · evidence_gap · applicable[].evidence · outcome.clauses&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;a verdict for all 23 clauses, each tagged &amp;#x27;code&amp;#x27; or &amp;#x27;model&amp;#x27;; every applying clause carries its evidence; the gaps&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#FBC02D;" vertex="1" parent="aud"><mxGeometry x="10" y="404" width="450" height="96" as="geometry"/></mxCell><mxCell id="p3-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1" source="o-policy" target="a-policy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a-supervisor" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;supervisor_log (append-only) · research_attempts · route&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;one line per pass: decision → route → why&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#FBC02D;" vertex="1" parent="aud"><mxGeometry x="10" y="564" width="450" height="96" as="geometry"/></mxCell><mxCell id="p3-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1" source="o-supervisor" target="a-supervisor"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a-brief" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;citations · brief_dropped&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;the fact IDs the brief rests on; statements deleted for citing nothing real (EVD-02)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#FBC02D;" vertex="1" parent="aud"><mxGeometry x="10" y="734" width="450" height="96" as="geometry"/></mxCell><mxCell id="p3-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1" source="o-brief" target="a-brief"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ls" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;② LangSmith — automatic, outside the code&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Switched on by .env, no code:&lt;/b&gt; LANGSMITH_TRACING=true · project &lt;b&gt;lloyds-genai&lt;/b&gt; · APAC endpoint&lt;br&gt;&lt;br&gt;&lt;b&gt;Captured — latest trace, 11 runs (7 chain + 4 tool):&lt;/b&gt;&lt;div style=&#x27;font-family:Menlo,monospace;font-size:10px;white-space:pre;margin:4px 0;line-height:1.35&#x27;&gt;LangGraph ................ 19.37 s&lt;br&gt;├ research ...............  0.66 s&lt;br&gt;│ ├ get_company_profile  (tool)&lt;br&gt;│ ├ get_filing_history   (tool)&lt;br&gt;│ ├ get_charges          (tool)&lt;br&gt;│ └ get_officers         (tool)&lt;br&gt;├ signal .................  3.23 s  ← Claude inside, not shown&lt;br&gt;├ policy .................  0.00 s&lt;br&gt;├ supervisor .............  0.00 s&lt;br&gt;│ └ Unnamed  (the route lambda)&lt;br&gt;└ brief .................. 15.48 s  ← Claude inside, not shown&lt;/div&gt;Inputs and outputs of every node and tool, timings, errors, the retry loop as repeated node runs.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&#x27;#C62828&#x27;&gt;Not captured:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• the Claude calls in signal, policy and brief: &lt;b&gt;no llm runs, total_tokens = 0&lt;/b&gt; on every trace — they use the Anthropic SDK directly, which bypasses LangChain callbacks&lt;br&gt;• inside the MCP server (a separate process): pacing, cache hit or miss, HTTP status&lt;br&gt;&lt;br&gt;&lt;b&gt;Learning notebooks 02–05:&lt;/b&gt; their LangChain chat models &lt;i&gt;are&lt;/i&gt; traced as llm runs with tokens." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="90" width="520" height="560" as="geometry"/></mxCell><mxCell id="p3-e13" value="every graph.ainvoke" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#8E24AA;strokeWidth=1.5;dashed=1;dashPattern=2 2;endArrow=open;fontColor=#8E24AA;exitX=1;exitY=0.5;entryX=0;entryY=0.05;" edge="1" parent="1" source="o-start" target="ls"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="245" y="117"/><mxPoint x="245" y="76"/><mxPoint x="740" y="76"/><mxPoint x="740" y="140"/></Array></mxGeometry></mxCell><mxCell id="lg" value="③ Logs and files" style="swimlane;startSize=28;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#EF6C00;fontColor=#FFFFFF;strokeColor=#EF6C00;swimlaneFillColor=#FFF3E0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1310" y="90" width="570" height="560" as="geometry"/></mxCell><mxCell id="lg1" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;stdout · llm.usage_line()&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;one line per Claude call: node, #items, model that answered (shows a fallback), tokens in / out — from signal, policy, brief&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#EF6C00;" vertex="1" parent="lg"><mxGeometry x="10" y="36" width="550" height="92" as="geometry"/></mxCell><mxCell id="lg2" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;stderr · MCP server INFO&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;&amp;#x27;Processing request of type CallToolRequest / ListToolsRequest&amp;#x27; — one per tool call&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#EF6C00;" vertex="1" parent="lg"><mxGeometry x="10" y="138" width="550" height="92" as="geometry"/></mxCell><mxCell id="lg3" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;stdout · policy warning&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;&amp;#x27;(!) SEC-09 has no rule in code — the model judges it&amp;#x27; when a clause has no rule&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#EF6C00;" vertex="1" parent="lg"><mxGeometry x="10" y="240" width="550" height="92" as="geometry"/></mxCell><mxCell id="lg4" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;mcp_ch/cache/*.json&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;every Companies House response; replays a run with zero API calls; agent_check proves live vs cached by counting files&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#EF6C00;" vertex="1" parent="lg"><mxGeometry x="10" y="342" width="550" height="92" as="geometry"/></mxCell><mxCell id="lg5" value="&lt;div style=&quot;font-family:Menlo,monospace;font-weight:bold;font-size:11px;word-break:break-all;&quot;&gt;production/state/*.json + saved notebook outputs&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#37474F;margin-top:2px;&quot;&gt;state after signal for 36EL and Tesco; the notebooks keep each run&amp;#x27;s printed results&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fillColor=#FFFFFF;strokeColor=#EF6C00;" vertex="1" parent="lg"><mxGeometry x="10" y="444" width="550" height="92" as="geometry"/></mxCell><mxCell id="tt" value="④ Offline checks — genai/tests (pytest)" style="swimlane;startSize=28;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#00897B;fontColor=#FFFFFF;strokeColor=#00897B;swimlaneFillColor=#E0F2F1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="760" y="680" width="520" height="310" as="geometry"/></mxCell><mxCell id="tt1" value="Not runtime monitoring — checks that run on every change, before a run:&lt;br&gt;• &lt;b&gt;data contract&lt;/b&gt;: 399,767 real charges vs the code&#x27;s assumptions (found the flag bug)&lt;br&gt;• &lt;b&gt;rules&lt;/b&gt;: each clause at its boundary; the three data fixes; 1 xfail = SEC-07 open question&lt;br&gt;• &lt;b&gt;properties&lt;/b&gt;: generated companies — order-free refs, EVD-07 consistency, lateness monotone&lt;br&gt;• &lt;b&gt;snapshots&lt;/b&gt;: 36EL / Tesco reproduce saved records and notebook 03 results offline&lt;br&gt;&lt;font color=&#x27;#546E7A&#x27;&gt;49 passed + 1 xfail in ~5 s; full data scan ~20 s&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=#E0F2F1;strokeColor=#00897B;fontSize=11;" vertex="1" parent="tt"><mxGeometry x="10" y="36" width="500" height="262" as="geometry"/></mxCell><mxCell id="gaps" value="&lt;b&gt;Gaps and the next steps that close them&lt;/b&gt; (in order of value for effort)&lt;br&gt;1. &lt;b&gt;Trace the Claude calls:&lt;/b&gt; in copilot/llm.py wrap the client — &lt;code&gt;from langsmith.wrappers import wrap_anthropic; wrap_anthropic(anthropic.AsyncAnthropic())&lt;/code&gt; (available in the installed langsmith 0.12.4). Prompts, outputs, tokens and latency then appear as llm runs under signal / policy / brief.&lt;br&gt;2. &lt;b&gt;Label each run:&lt;/b&gt; graph.ainvoke(state, config={&#x27;run_name&#x27;: &#x27;rm-copilot 10812571&#x27;, &#x27;metadata&#x27;: {&#x27;company_number&#x27;: …, &#x27;as_of&#x27;: …}, &#x27;tags&#x27;: [&#x27;production&#x27;]}) — filter traces by company; link a brief to its trace.&lt;br&gt;3. &lt;b&gt;Cost per company:&lt;/b&gt; once 1 is in, LangSmith sums tokens per trace; until then, add up usage_line.&lt;br&gt;4. &lt;b&gt;Online evaluation:&lt;/b&gt; a LangSmith dataset of fixed companies + evaluators (brief faithfulness judge, expected outcomes) — the evaluation plan, run against traces.&lt;br&gt;5. &lt;b&gt;Run-level metrics to watch:&lt;/b&gt; evidence-gap rate, retries per company, statements dropped, quote-check failures, tokens and seconds per company.&lt;br&gt;6. &lt;b&gt;Inside the MCP server:&lt;/b&gt; log cache hit / miss and HTTP status per call (ch_client) — today a slow research node can&#x27;t say why." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1310" y="680" width="570" height="310" as="geometry"/></mxCell><mxCell id="leg3" value="&lt;b&gt;Key&lt;/b&gt; &amp;nbsp; ① state = returned by every run, in code &amp;nbsp;│&amp;nbsp; ② LangSmith = automatic, external &amp;nbsp;│&amp;nbsp; ③ logs and files = local &amp;nbsp;│&amp;nbsp; ④ tests = before a run, not during" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=#FAFAFA;strokeColor=#9E9E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="1010" width="1020" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>